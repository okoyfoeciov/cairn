# Owner: 07 (CONTRACT §6.4 / spec-07 §1)
#
# NB: `.claude-session-active` is deliberately NOT listed here.  That file's own
# text asks not to be ignored: its only job is to keep the worktree dirty so
# `git worktree remove` refuses without --force, which is what forces a session
# to ask before tearing the worktree down.  Ignoring it makes `git status` read
# clean and silently disables that safety.  Use explicit paths or `git add -u`
# when committing, never `git add .`, so it stays out of commits.

# Rust build output
target/
core/target/


# Frontend build output
node_modules/
# generated by electron-shell/build-app.mjs, whose own header says never to
# commit it.
electron-shell/app/
# generated by electron-shell/build-native.mjs: the Node-API addon.
# ~2.9 MB of platform-specific cdylib, rebuilt from core/napi in ~30 s, and
# it must never be committed for the reason `target/` must not -- a stale binary
# that reproduces an old measurement to the digit is how this project lost a day
# on gate G9.
electron-shell/cairn.node
# build-native.mjs's temp file, left behind only if a build is killed mid-publish.
electron-shell/cairn.node.tmp-*

# Packaging artefacts
*.dmg

# generated by tools/package-electron.mjs (§8.2 step 10): the assembled app and
# the .deb.  ~288 MB of Electron distribution per build; never committed, for
# the same reason target/ is not.
out/


# Generated fixture vaults (tools/gen-vault.sh)
fixtures/
/vault-*/
*.vault/

# Gate G-RT's frame fixtures, written by core/tests/frame_fixtures.rs on
# every `npm test` (via `pretest`).  Generated, not authored: ~1.25 MB of binary
# frames, two of which are the 200 KiB and 1 MiB §2.4 cases.  They are rebuilt
# from `encode_note` each run, which is the point -- a committed frame could
# drift from the encoder and would then be a fixture that proves nothing.
tests/fixtures/frames/

# macOS
.DS_Store
